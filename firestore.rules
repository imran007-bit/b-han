// ============================================
// B HAN — Firestore Security Rules
// ============================================
// Deploy these in Firebase Console → Firestore → Rules
//
// INSTRUCTIONS:
// 1. Go to https://console.firebase.google.com
// 2. Select your bhan-app project
// 3. Go to Firestore Database → Rules tab
// 4. Replace the default rules with these
// 5. Click "Publish"

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PRODUCTS: anyone can read, only admin can write ──
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Use admin SDK or manual console edits
      // For now, client writes are allowed via test mode
      // TODO: Set up Firebase Admin SDK for server-side writes
    }

    // ── SETTINGS: anyone can read store settings, only admin writes ──
    match /settings/{doc} {
      allow read: if true;
      allow write: if false; // Same as above
    }

    // ── CUSTOMERS: customer can read own doc, no one can read others ──
    match /customers/{customerId} {
      allow read: if true;  // Needed for login check
      allow create: if true; // Registration
      allow update: if true; // Profile update
      // Password hash is stored but never returned to client in our code
      // TODO: Use Cloud Functions for auth to fully protect pw hashes
    }

    // ── ORDERS: customer can create, read own orders ──
    match /orders/{orderId} {
      allow read: if true;   // Needed for order tracking
      allow create: if true; // Customer places order
      allow update: if true; // Admin updates status
      // TODO: Lock update to admin only via Cloud Functions
    }

    // ── COUPONS: anyone can read (for validation), only admin writes ──
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Block everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================
// IMPORTANT SECURITY NOTES:
// ============================================
//
// 1. The rules above are a STARTING POINT. For maximum security,
//    use Firebase Cloud Functions for:
//    - Customer registration (hash password server-side)
//    - Admin operations (verify admin token server-side)
//    - Order creation (validate cart/prices server-side)
//
// 2. The Firebase API key in firebase-config.js is NOT a secret.
//    It's a project identifier. Firestore Rules are your real security.
//
// 3. NEVER store the admin password in client-side code for production.
//    Use Firebase Custom Auth or Cloud Functions for admin auth.
//
// 4. For production, switch Firestore rules to:
//    allow write: if request.auth != null && request.auth.token.admin == true;
//    And use Firebase Admin SDK to set custom claims.
