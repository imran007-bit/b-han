rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = signed-in user whose UID exists in the 'admins' collection.
    // One-time setup: Firebase Console → Firestore → create collection "admins"
    // → document ID = your UID (Authentication → Users tab) → add any field (role: "owner").
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist: readable only by that admin, writable only via Console
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Store settings: public read, admin-only write
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: public read, admin-only write
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - create: any signed-in customer (checkout requires login)
    // - get (single doc by exact ID): public — enables order tracking by ID
    // - list: admin sees all; customers only their own orders (query by customerId)
    // - update/delete: admin only (tracking status updates)
    match /orders/{doc} {
      allow create: if request.auth != null;
      allow get: if true;
      allow list: if isAdmin()
        || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Customers: each user reads/writes ONLY their own profile; admin reads all
    match /customers/{uid} {
      allow create, get, update: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list, delete: if isAdmin();
    }

    // Coupons: public read, admin-only write
    match /coupons/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
